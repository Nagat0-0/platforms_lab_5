@page "/rentals/delete"
@using Microsoft.EntityFrameworkCore
@using lab_5.Models
@inject IDbContextFactory<lab_5.Models.RentalDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>Rental</h2>
    <hr />
    @if (rental is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Client</dt>
            <dd class="col-sm-10">@rental.Client?.LastName @rental.Client?.FirstName</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Product</dt>
            <dd class="col-sm-10">@rental.Product?.Title</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">IssueDate</dt>
            <dd class="col-sm-10">@rental.IssueDate</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">ReturnDate</dt>
            <dd class="col-sm-10">@rental.ReturnDate</dd>
        </dl>
        <EditForm method="post" Model="rental" OnValidSubmit="DeleteRental" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(rental is null)">Delete</button> |
            <a href="/rentals">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private Rental? rental;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        rental = await context.Rentals
            .Include(r => r.Client)
            .Include(r => r.Product)
            .FirstOrDefaultAsync(m => m.Id == Id);

        if (rental is null)
        {
            NavigationManager.NotFound();
        }
    }

    private async Task DeleteRental()
    {
        using var context = DbFactory.CreateDbContext();
        context.Rentals.Remove(rental!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/rentals");
    }
}
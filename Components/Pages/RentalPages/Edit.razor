@page "/rentals/edit"
@using Microsoft.EntityFrameworkCore
@using lab_5.Models
@inject IDbContextFactory<lab_5.Models.RentalDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Edit</PageTitle>

<h1>Edit</h1>

<h2>Rental</h2>
<hr />
@if (Rental is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="Rental" OnValidSubmit="UpdateRental" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary role="alert"/>
                <input type="hidden" name="Rental.Id" value="@Rental.Id" />
                
                <div class="mb-3">
                    <label for="clientid" class="form-label">Client:</label>
                    <InputSelect id="clientid" @bind-Value="Rental.ClientId" class="form-control">
                        <option value="">-- Select Client --</option>
                        @foreach (var client in ClientsList)
                        {
                            <option value="@client.Id">@client.LastName @client.FirstName</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="() => Rental.ClientId" class="text-danger" />
                </div>
                
                <div class="mb-3">
                    <label for="productid" class="form-label">Product:</label>
                    <InputSelect id="productid" @bind-Value="Rental.ProductId" class="form-control">
                        <option value="">-- Select Product --</option>
                        @foreach (var product in ProductsList)
                        {
                            <option value="@product.Id">@product.Title</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="() => Rental.ProductId" class="text-danger" />
                </div>
                
                <div class="mb-3">
                    <label for="issuedate" class="form-label">IssueDate:</label>
                    <InputDate id="issuedate" @bind-Value="Rental.IssueDate" class="form-control" />
                    <ValidationMessage For="() => Rental.IssueDate" class="text-danger" />
                </div>
                
                <div class="mb-3">
                    <label for="returndate" class="form-label">ReturnDate:</label>
                    <InputDate id="returndate" @bind-Value="Rental.ReturnDate" class="form-control" />
                    <ValidationMessage For="() => Rental.ReturnDate" class="text-danger" />
                </div>
                
                <button type="submit" class="btn btn-primary">Save</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/rentals">Back to List</a>
</div>

@code {
    [SupplyParameterFromQuery]
    private int Id { get; set; }

    [SupplyParameterFromForm]
    private Rental? Rental { get; set; }

    [PersistentState]
    public Rental? RentalState { get; set; }

    private List<Client> ClientsList = new();
    private List<Product> ProductsList = new();

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        
        Rental ??= RentalState ??= await context.Rentals.FirstOrDefaultAsync(m => m.Id == Id);

        ClientsList = await context.Clients.ToListAsync();
        ProductsList = await context.Products.ToListAsync();

        if (Rental is null)
        {
            NavigationManager.NotFound();
        }
    }

    private async Task UpdateRental()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(Rental!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!RentalExists(Rental!.Id))
            {
                NavigationManager.NotFound();
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/rentals");
    }

    private bool RentalExists(int id)
    {
        using var context = DbFactory.CreateDbContext();
        return context.Rentals.Any(e => e.Id == id);
    }
}